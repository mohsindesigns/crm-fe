# Backend origin used by next.config.ts to proxy /api/* server-side (rewrites),
# so pages can call same-origin /api URLs instead of a cross-port absolute URL
# (avoids CORS/framing issues, e.g. the /review PDF iframe). Server-side only —
# no NEXT_PUBLIC_ prefix, not exposed to the browser bundle.
BACKEND_URL=http://localhost:5000

# Base URL the browser calls directly for API requests (axios in src/lib/api.ts)
# and a few pages that fetch before the app shell mounts. Leave empty to use
# relative /api paths (works with the BACKEND_URL rewrite above).
NEXT_PUBLIC_API_URL=/api

# Default org subdomain pre-filled on the login page.
NEXT_PUBLIC_ORG_SUBDOMAIN=mohsindesigns
